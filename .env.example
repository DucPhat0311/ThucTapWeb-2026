# Copy this file to .env on the Ubuntu server.
# Do not commit .env.

MYSQL_ROOT_PASSWORD=change-this-password
DB_OPTION=?connectionTimeZone=%2B07:00&forceConnectionTimeZoneToSession=true&useUnicode=true&characterEncoding=UTF-8

# Required when using upload features.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional OAuth/payment integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://nguyenhandeptrai.id.vn/vnpay-return

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URL=https://nguyenhandeptrai.id.vn/auth/facebook
FACEBOOK_API_VERSION=v19.0

# Optional GHN shipping integration.
GHN_TOKEN=
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_SHOP_ID=
GHN_FROM_NAME=
GHN_FROM_PHONE=
GHN_FROM_ADDRESS=
GHN_FROM_WARD_NAME=
GHN_FROM_DISTRICT_NAME=
GHN_FROM_PROVINCE_NAME=
